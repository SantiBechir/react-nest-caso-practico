{
  "name": "activation-poc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.15 <25", "pnpm": ">=11 <12" },
  "scripts": {
    "build": "pnpm -r build",
    "build:contracts": "pnpm --filter @activation/contracts build",
    "dev": "pnpm build:contracts && pnpm -r --parallel --filter \"./apps/**\" dev",
    "dev:api": "pnpm build:contracts && pnpm --filter @activation/activation-api dev",
    "dev:ui": "pnpm build:contracts && pnpm --filter @activation/demo-ui dev",
    "typecheck": "pnpm build:contracts && pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
